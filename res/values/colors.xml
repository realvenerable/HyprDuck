<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Single dark scheme, applied in both light and dark system mode. The
      reference set is dark throughout, and the tokens below are literal rather
      than ?android:attr references on purpose: the framework's text colors would
      resolve to dark values in light mode and vanish on a dark surface.
    -->

    <!-- Adaptive icon background, matches the window background. -->
    <color name="ic_launcher_background">#0B0B0D</color>

    <!-- Surfaces -->
    <color name="bl_background">#0B0B0D</color>
    <color name="bl_card">#1A1A1D</color>
    <color name="bl_card_stroke">#2C2C31</color>
    <color name="bl_track">#26262A</color>
    <color name="bl_segment_selected">#33333A</color>

    <!-- Content -->
    <color name="bl_text_primary">#F5F5F7</color>
    <color name="bl_text_secondary">#8A8A8F</color>
    <color name="bl_on_accent">#0B0B0D</color>

    <!-- Fallback accent for API 26-30, where there is no wallpaper palette. -->
    <color name="bl_accent_fallback">#F2C94C</color>
</resources>
