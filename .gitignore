# Signing keys. Never commit these: a keystore is the only thing that
# authorises updates to an installed copy of the app. Losing one means the app
# has to be uninstalled before a new build will install over it.
*.jks
*.keystore

# Build output
build/
dist/
*.apk
*.idsig
*.ap_
*.dex

# Generated by aapt2 link, and regenerated by every build
R.java

# Local machine paths
local.properties

# Editors and operating systems
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db
*.swp
*~
